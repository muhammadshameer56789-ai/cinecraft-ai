# UNTESTED sample. Serves the built frontend and proxies /api to the backend on the same origin (so the session cookie just works).
server {
  listen 443 ssl;
  server_name photos.example.com;
  # ssl_certificate / ssl_certificate_key ...

  client_max_body_size 22m;               # a little above MAX_UPLOAD_MB
  root /var/www/cinecraft;                # contents of frontend/dist
  index index.html;

  location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header X-Forwarded-For $remote_addr;   # set TRUSTED_PROXY=true only with this in place
    proxy_set_header Host $host;
    proxy_read_timeout 120s;
  }
  location / { try_files $uri /index.html; }
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com" always;
}
